---
/**
 * Variant `video` — fullscreen hero with a background video.
 * Only GHL direct-.mp4 (`video_provider: 'ghl'`) autoplays as the backdrop
 * (muted, loop, playsinline, poster fallback, reduced-motion respected).
 * YouTube slides and slides without video fall back to the poster image —
 * a background YouTube iframe is deliberately not shipped (weight + policy).
 * Copy/overlay treatment mirrors variant `one`.
 */
import type { HeroData } from '../../../../data/types';
import ResponsiveImage from '../../../ui/ResponsiveImage.astro';
import Button from '../../../ui/Button.astro';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const slide = data.slides[0];

const overlayClass: Record<string, string> = {
  dark: 'bg-gradient-to-br from-dark/90 via-dark/70 to-primary/50',
  primary: 'bg-gradient-to-br from-primary/90 via-primary/60 to-accent/40',
  accent: 'bg-gradient-to-br from-accent/80 via-dark/70 to-primary/50',
  none: 'bg-dark/30',
};

const bgVideo =
  slide.video_provider === 'ghl' && (slide.video_url ?? '').trim() !== ''
    ? slide.video_url!.trim()
    : null;
const poster = (slide.video_poster ?? '').trim() || slide.image;
---

<section class="relative -mt-[5.5rem] md:-mt-[6.5rem]" aria-label="Hero">
  <div class="relative h-screen min-h-[560px] md:min-h-[650px] overflow-hidden">
    <div class="absolute inset-0">
      {
        bgVideo ? (
          <video
            class="h-full w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={poster}
            aria-hidden="true"
            data-hero-bg-video
          >
            <source src={bgVideo} type="video/mp4" />
          </video>
        ) : (
          <ResponsiveImage
            src={poster}
            alt={slide.image_alt}
            width={1920}
            height={1080}
            lcp={true}
            class="w-full h-full object-cover"
            sizes="100vw"
          />
        )
      }
    </div>
    <div
      class:list={['absolute inset-0', overlayClass[slide.overlay ?? 'dark'] ?? overlayClass.dark]}
    />
    <div class="relative z-10 container-site h-full grid place-items-center text-center text-white px-4 pt-20">
      <div class="max-w-4xl mx-auto">
        <p class="text-accent/90 font-semibold text-sm md:text-base uppercase tracking-[0.2em] mb-4">
          {slide.tagline}
        </p>
        <h1 class="font-heading text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6 leading-[1.1]">
          {slide.headline}
        </h1>
        <p class="text-white/80 text-base md:text-lg max-w-xl mx-auto mb-8">{slide.text}</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href={slide.cta_primary.href} variant="primary" size="lg">
            {slide.cta_primary.label}
          </Button>
          {slide.cta_secondary && (
            <Button
              href={slide.cta_secondary.href}
              variant="outline"
              size="lg"
              class="!border-white/40 !text-white hover:!bg-white hover:!text-primary"
            >
              {slide.cta_secondary.label}
            </Button>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-28 bg-gradient-to-t from-surface to-transparent pointer-events-none">
  </div>
</section>

<script>
  // Respect reduced motion: a backdrop that moves without consent is a bug.
  function stillHeroVideo() {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLVideoElement>('video[data-hero-bg-video]').forEach((v) => {
      v.pause();
      v.removeAttribute('autoplay');
    });
  }

  stillHeroVideo();
  document.addEventListener('astro:page-load', stillHeroVideo);
</script>
