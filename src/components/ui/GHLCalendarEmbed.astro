---
/**
 * GHL calendar embed — renders the LeadConnector booking widget iframe.
 * Unconfigured (missing or YOUR_* placeholder ID) renders a visible placeholder
 * in dev and nothing in production builds.
 */
import { isGhlConfigured } from '../../lib/ghl';

interface Props {
  calendarId?: string;
  height?: string;
}

const { calendarId, height = '700px' } = Astro.props;

const isDev = import.meta.env.DEV;
const configured = isGhlConfigured(calendarId);
---

{
  configured ? (
    <div class="w-full" style={`min-height: ${height}`}>
      <iframe
        src={`https://api.leadconnectorhq.com/widget/booking/${calendarId}`}
        style={`width: 100%; height: ${height}; border: none; overflow: hidden;`}
        title="Book a Call"
        loading="lazy"
      />
    </div>
  ) : isDev ? (
    <div
      class="flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-border bg-surface px-8 py-10 text-center text-sm text-muted"
      style={`min-height: ${height}`}
    >
      <p class="font-heading font-semibold text-dark">GHL Calendar Embed</p>
      <p class="text-xs">
        Set a real calendar ID in <code class="rounded bg-border px-1 font-mono">src/lib/ghl.ts</code>{' '}
        to render the live booking widget.
      </p>
    </div>
  ) : null
}
